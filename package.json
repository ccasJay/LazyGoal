{
  "name": "lazygoal",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "main": "index.js",
  "bin": {
    "lazygoal": "bin/lazygoal.cjs"
  },
  "scripts": {
    "llm:decision-eval": "tsx packages/agent/test/decision-guidance-eval.ts",
    "llm:agent-smoke": "tsx packages/llm/test/agent-smoke-test.ts",
    "llm:native-dialogue-smoke": "tsx packages/llm/test/native-dialogue-smoke.ts",
    "check:dependencies": "node scripts/check-dependencies.mjs",
    "benchmark:context-retrieval": "tsx scripts/benchmark-context-retrieval.ts",
    "memory:check": "node scripts/project-memory.mjs check",
    "memory:index": "node scripts/project-memory.mjs write-index",
    "test:memory": "node --test scripts/project-memory.test.mjs",
    "test:gepa-adapter": "uv run --project prompt-evaluation/gepa --frozen python -W error::ResourceWarning -m unittest discover -s prompt-evaluation/gepa/tests -v",
    "smoke:gepa-lifecycle": "uv run --project prompt-evaluation/gepa --frozen lazygoal-gepa-lifecycle-smoke",
    "smoke:gepa-adapter": "uv run --project prompt-evaluation/gepa --frozen lazygoal-gepa-lifecycle-smoke",
    "e2e:gaia-real": "uv run --project prompt-evaluation/gepa --frozen lazygoal-gepa-gaia-e2e",
    "build:web": "npm run --prefix apps/goal-board build",
    "dev:web": "npm run --prefix apps/goal-board dev",
    "test:web-e2e": "node --test apps/goal-board/e2e/*.test.mjs",
    "test": "node scripts/run-regression.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/diff": "^7.0.2",
    "@types/node": "^26.1.2",
    "@types/picomatch": "^4.0.3",
    "js-tiktoken": "^1.0.21",
    "tsx": "^4.23.7",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "diff": "9.0.0",
    "marked": "^18.0.13",
    "picomatch": "4.0.7"
  }
}
