{
  "name": "@lazygoal/benchmarks",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts alfworld/test/*.test.ts swebench/test/*.test.ts gaia/test/*.test.ts tua-bench/test/*.test.ts",
    "tua-bench:worker-smoke": "cd .. && tsx benchmarks/tua-bench/src/worker-smoke.ts",
    "gaia:worker-smoke": "cd .. && tsx benchmarks/gaia/src/worker-smoke.ts",
    "gaia:eval": "cd .. && tsx benchmarks/gaia/src/cli.ts eval gaia",
    "gaia:load": "cd .. && tsx benchmarks/gaia/src/cli.ts load gaia",
    "gaia:grade": "cd .. && tsx benchmarks/gaia/src/cli.ts grade gaia",
    "swebench:test-python": "python3 -B -m unittest discover -s swebench/python -p 'test_*.py'",
    "swebench:eval": "cd .. && tsx benchmarks/swebench/src/cli.ts",
    "swebench:single": "cd .. && tsx benchmarks/swebench/src/cli.ts eval swebench --manifest benchmarks/swebench/manifests/single.json",
    "swebench:smoke": "cd .. && tsx benchmarks/swebench/src/cli.ts eval swebench --manifest benchmarks/swebench/manifests/smoke.json",
    "swebench:worker-smoke": "cd .. && tsx benchmarks/swebench/src/worker-smoke.ts",
    "alfworld:test-python": "python -B -m unittest discover -s alfworld/python -p 'test_*.py'",
    "alfworld:init": "tsx alfworld/scripts/init-alfworld.ts",
    "alfworld:download": "tsx alfworld/scripts/download-alfworld.ts",
    "alfworld:preflight": "tsx alfworld/scripts/preflight-alfworld.ts",
    "alfworld:worker-smoke": "cd .. && tsx benchmarks/alfworld/src/worker-smoke.ts",
    "prompt-evaluation:smoke": "cd .. && tsx benchmarks/alfworld/src/prompt-evaluation-smoke.ts",
    "alfworld:eval": "cd .. && tsx benchmarks/alfworld/src/cli.ts",
    "alfworld:smoke": "cd .. && tsx benchmarks/alfworld/src/cli.ts eval alfworld --manifest benchmarks/alfworld/manifests/smoke.json --min-success-rate 0",
    "alfworld:regression": "cd .. && tsx benchmarks/alfworld/src/cli.ts eval alfworld --manifest benchmarks/alfworld/manifests/regression.json --min-success-rate 0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.7",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.4.0",
    "smol-toml": "^1.8.0"
  }
}
