{
    "model": "golden-model",
    "messages": [
        { "role": "system", "content": "You are helpful." },
        { "role": "user", "content": "Summarize." }
    ],
    "max_tokens": 1024,
    "response_format": {
        "type": "json_schema",
        "json_schema": {
            "name": "answer",
            "schema": {
                "type": "object",
                "properties": { "answer": { "type": "string" } },
                "required": ["answer"],
                "additionalProperties": false
            },
            "strict": true
        }
    }
}
